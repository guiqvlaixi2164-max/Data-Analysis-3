   "source": [
    "## 0. Separate train and holdout data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Remove observations with missing fast_growth (our target variable)\n",
    "data = data[data['fast_growth'].notna()].copy()\n",
    "print(f\"Modeling dataset: {data.shape[0]} observations\")\n",
    "\n",
    "# Create train-test split (80-20)\n",
    "data_train, data_holdout = train_test_split(data, train_size=0.8, random_state=42)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
